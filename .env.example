# 环境变量示例（复制为 .env 并按需修改）
# 注意：.env 已被 .gitignore 忽略，切勿提交到仓库

# 密钥（appid:secret，多个用逗号分隔）——生产必改！
OCR_APP_SECRETS="demo:CHANGE_ME_demo_secret_key_please_replace"

# 全局限流
OCR_RATE_LIMIT_PER_SECOND=2
OCR_RATE_LIMIT_BURST=5

# 图片大小上限（字节），默认 5MB
OCR_MAX_UPLOAD_SIZE=5242880

# 签名开关（生产必须 true）
OCR_ENABLE_SIGNATURE=true

# 测试界面开关（本地测试 true，生产必须 false）
OCR_ENABLE_TEST_UI=true

# 签名时间戳偏差 / Nonce 缓存时长（秒）
OCR_SIGNATURE_CLOCK_SKEW=300
OCR_NONCE_TTL=300
